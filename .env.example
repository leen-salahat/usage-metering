DATABASE_URL=postgres://metering:metering@localhost:5433/metering
TEST_DATABASE_URL=postgres://metering:metering@localhost:5433/metering_test
PORT=3000

# Optional: used by docker-compose.yml (defaults shown). Change them for anything but local demos.
# Avoid special characters in the password: it is embedded in DATABASE_URL.
# POSTGRES_USER=metering
# POSTGRES_PASSWORD=metering
# POSTGRES_DB=metering
# SERVICE_PORT=3000
